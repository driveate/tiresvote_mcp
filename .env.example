# tiresvote-mcp environment variables — documentation only.
# The server reads the process environment and never auto-loads a .env file;
# prefer the MCP client's server `env` block (see README) over a local .env.
# Same key as the Wheel Fitment API. Never commit a real key.
WHEELSIZE_API_KEY=
TIRES_API_BASE_URL=https://api.wheel-size.com
TIRES_API_HOST_HEADER=
